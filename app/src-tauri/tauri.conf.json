{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chroma",
  "version": "0.1.0",
  "identifier": "com.chroma.console",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CHROMA \u2014 Console",
        "width": 1472,
        "height": 864,
        "minWidth": 1000,
        "minHeight": 600,
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: chroma-art: http://chroma-art.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
