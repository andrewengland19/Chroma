{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CHROMA common definitions",
  "description": "Shared building blocks referenced by the other contracts.",
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "hue": { "type": "number", "minimum": 0, "exclusiveMaximum": 360, "description": "Degrees in [0, 360)." },
    "bank": { "type": "string", "enum": ["A", "B", "C"] },
    "ch": { "type": "integer", "minimum": 1, "maximum": 8 },
    "slot": { "type": "integer", "minimum": 0, "maximum": 7, "description": "Palette swatch or cue index." },
    "fader_fn": { "type": "string", "enum": ["level", "hue", "sat"] },
    "who": { "type": "string", "enum": ["auto", "board"] },
    "art_mode": { "type": "string", "enum": ["det", "paint", "ai"] },
    "src": { "type": "string", "enum": ["ui", "board", "replay", "cli"] },
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "slug_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
    "take_id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}(-[0-9]{1,3})?$" },
    "ms": { "type": "integer", "minimum": 0 },
    "record_mode": { "type": "string", "enum": ["replace", "overdub", "merge"] }
  }
}
