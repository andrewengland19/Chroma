{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConsoleFile",
  "description": "~/.chroma/console.json — persisted console: channel values, palette, cues, last bank / fader function, playback offset.",
  "type": "object",
  "required": ["v", "bank", "fader_fn", "master", "channels", "palette", "cues"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "bank": { "$ref": "common.schema.json#/$defs/bank" },
    "fader_fn": { "$ref": "common.schema.json#/$defs/fader_fn" },
    "master": { "$ref": "common.schema.json#/$defs/unit" },
    "channels": { "type": "array", "minItems": 24, "maxItems": 24, "items": { "$ref": "#/$defs/look_channel" } },
    "palette": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "common.schema.json#/$defs/hex" } },
    "cues": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/cue" } },
    "play_offset_ms": { "type": "integer", "minimum": -2000, "maximum": 2000, "description": "Global replay offset added to every take's nudge." }
  },
  "$defs": {
    "look_channel": {
      "type": "object", "required": ["level", "hue", "sat"], "additionalProperties": false,
      "properties": {
        "level": { "$ref": "common.schema.json#/$defs/unit" },
        "hue": { "$ref": "common.schema.json#/$defs/hue" },
        "sat": { "$ref": "common.schema.json#/$defs/unit" }
      }
    },
    "cue": {
      "type": "object", "required": ["name", "look"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 24 },
        "fade_ms": { "$ref": "common.schema.json#/$defs/ms" },
        "look": { "oneOf": [
          { "type": "array", "minItems": 24, "maxItems": 24, "items": { "$ref": "#/$defs/look_channel" } },
          { "type": "null" } ], "description": "Snapshot of all 24 channels (not master / who / bank); null = empty." }
      }
    }
  }
}
