{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TakeHeader",
  "description": "First line of ~/.chroma/takes/<id>_<slug>.jsonl (BUILD_ORDER §5.4). Rewritten atomically when the take changes.",
  "type": "object",
  "required": ["v", "id", "name", "track_id", "title", "artist", "album", "dur_ms", "fixtures_rev",
               "nudge_ms", "training", "markers"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/take_id" },
    "name": { "type": "string", "maxLength": 64, "description": "e.g. 'Older — draft 03'." },
    "track_id": { "type": "string" },
    "title": { "type": "string" }, "artist": { "type": "string" }, "album": { "type": "string" },
    "dur_ms": { "oneOf": [{ "$ref": "common.schema.json#/$defs/ms" }, { "type": "null" }] },
    "fixtures_rev": { "type": "integer", "minimum": 0 },
    "nudge_ms": { "type": "integer", "minimum": -2000, "maximum": 2000 },
    "training": { "type": "boolean", "description": "Include in the AI training set." },
    "markers": { "type": "array", "items": { "$ref": "#/$defs/marker" } },
    "created_ms": { "type": "integer", "minimum": 0, "description": "Wall-clock ms when recording started." },
    "performer": { "type": "string" },
    "art_hex": { "oneOf": [{ "$ref": "common.schema.json#/$defs/hex" }, { "type": "null" }],
                 "description": "Dominant album-art colour when recording started (library thumbnail)." },
    "sync_err_ms": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }],
                     "description": "Largest SongClock resync correction seen while recording." },
    "init": { "$ref": "#/$defs/init" },
    "groups": { "type": "object", "description": "Group names/colours at record time, keyed by group id (for lanes).",
                "additionalProperties": { "type": "object", "required": ["name", "color"], "additionalProperties": false,
                  "properties": { "name": { "type": "string" }, "color": { "$ref": "common.schema.json#/$defs/hex" } } } },
    "stats": { "type": "object", "additionalProperties": false, "required": ["events", "groups_used", "length_ms"],
               "properties": { "events": { "type": "integer", "minimum": 0 },
                               "groups_used": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug_id" } },
                               "length_ms": { "$ref": "common.schema.json#/$defs/ms" } } }
  },
  "$defs": {
    "marker": {
      "type": "object", "required": ["p", "label"], "additionalProperties": false,
      "properties": { "p": { "$ref": "common.schema.json#/$defs/ms" }, "label": { "type": "string", "minLength": 1, "maxLength": 16 } }
    },
    "init": {
      "type": "object", "title": "TakeInit", "description": "Console snapshot when recording started (replay seeds from it).",
      "required": ["bank", "fader_fn", "master", "blackout", "channels"], "additionalProperties": false,
      "properties": {
        "bank": { "$ref": "common.schema.json#/$defs/bank" },
        "fader_fn": { "$ref": "common.schema.json#/$defs/fader_fn" },
        "master": { "$ref": "common.schema.json#/$defs/unit" },
        "blackout": { "type": "boolean" },
        "channels": { "type": "array", "minItems": 24, "maxItems": 24, "items": {
          "type": "object", "required": ["group_id", "level", "hue", "sat"], "additionalProperties": false,
          "properties": {
            "group_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/slug_id" }, { "type": "null" }] },
            "level": { "$ref": "common.schema.json#/$defs/unit" },
            "hue": { "$ref": "common.schema.json#/$defs/hue" },
            "sat": { "$ref": "common.schema.json#/$defs/unit" } } } }
      }
    }
  }
}
