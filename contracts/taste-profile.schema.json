{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TasteProfile",
  "description": "Statistics of the user's own saved scenes (lighting-scene-agent-spec §5.4), generated by hub/scene_taste.py and injected into the agent's context as soft defaults. ~/.chroma/scene-agent/registry/taste_profile.json. Hand-editable: `overrides` survives regeneration and wins over the generated numbers.",
  "type": "object",
  "required": ["v", "scene_count", "strength", "brightness", "peak_brightness", "kelvin", "hues", "contrast"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "generated_at": { "type": "string" },
    "scenes": { "type": "array", "items": { "type": "string" }, "description": "The scenes the numbers came from." },
    "scene_count": { "type": "integer", "minimum": 0 },
    "strength": { "$ref": "common.schema.json#/$defs/unit", "description": "How hard the model should lean on the profile (1 = default)." },
    "brightness": { "oneOf": [{ "$ref": "#/$defs/range" }, { "type": "null" }], "description": "Per-scene mean brightness of lit fixtures." },
    "peak_brightness": { "oneOf": [{ "$ref": "common.schema.json#/$defs/unit" }, { "type": "null" }], "description": "Brightest single fixture in any scene." },
    "kelvin": { "oneOf": [{ "$ref": "#/$defs/kelvin_range" }, { "type": "null" }], "description": "Per-scene mean white colour temperature." },
    "hues": {
      "type": "array",
      "items": { "type": "object", "required": ["family", "share"], "additionalProperties": false,
                 "properties": { "family": { "enum": ["red", "orange", "yellow", "green", "cyan", "blue", "purple", "magenta", "white"] },
                                 "share": { "$ref": "common.schema.json#/$defs/unit" } } }
    },
    "contrast": { "oneOf": [{ "$ref": "#/$defs/range" }, { "type": "null" }], "description": "Zone contrast per scene." },
    "overrides": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "strength": { "$ref": "common.schema.json#/$defs/unit" },
        "brightness": { "$ref": "#/$defs/partial_range" },
        "kelvin": { "$ref": "#/$defs/partial_kelvin_range" },
        "contrast": { "$ref": "#/$defs/partial_range" }
      }
    }
  },
  "$defs": {
    "range": { "type": "object", "required": ["min", "median", "max"], "additionalProperties": false,
               "properties": { "min": { "$ref": "common.schema.json#/$defs/unit" }, "median": { "$ref": "common.schema.json#/$defs/unit" }, "max": { "$ref": "common.schema.json#/$defs/unit" } } },
    "kelvin_range": { "type": "object", "required": ["min", "median", "max"], "additionalProperties": false,
                      "properties": { "min": { "type": "integer", "minimum": 1500, "maximum": 9000 }, "median": { "type": "integer", "minimum": 1500, "maximum": 9000 }, "max": { "type": "integer", "minimum": 1500, "maximum": 9000 } } },
    "partial_range": { "type": "object", "minProperties": 1, "additionalProperties": false,
                       "properties": { "min": { "$ref": "common.schema.json#/$defs/unit" }, "median": { "$ref": "common.schema.json#/$defs/unit" }, "max": { "$ref": "common.schema.json#/$defs/unit" } } },
    "partial_kelvin_range": { "type": "object", "minProperties": 1, "additionalProperties": false,
                              "properties": { "min": { "type": "integer", "minimum": 1500, "maximum": 9000 }, "median": { "type": "integer", "minimum": 1500, "maximum": 9000 }, "max": { "type": "integer", "minimum": 1500, "maximum": 9000 } } }
  }
}
